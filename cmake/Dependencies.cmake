if(HUMAN_RESOURCES_BUILD_CLIENT OR HUMAN_RESOURCES_FEATURE_DYNAMIC_TEXT)
  if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/external/SDL/CMakeLists.txt")
    message(FATAL_ERROR "Pinned dependencies are absent. Run scripts/bootstrap-dependencies.sh")
  endif()

  if(IOS)
    set(SDL_SHARED OFF CACHE BOOL "" FORCE)
    set(SDL_STATIC ON CACHE BOOL "" FORCE)
  elseif(ANDROID)
    set(SDL_SHARED ON CACHE BOOL "" FORCE)
    set(SDL_STATIC OFF CACHE BOOL "" FORCE)
  else()
    # Desktop packages are self-contained executables by default. Products may
    # deliberately switch to shared SDL when their installer owns that policy.
    set(SDL_SHARED OFF CACHE BOOL "" FORCE)
    set(SDL_STATIC ON CACHE BOOL "" FORCE)
  endif()
  set(SDL_TESTS OFF CACHE BOOL "" FORCE)
  set(SDL_EXAMPLES OFF CACHE BOOL "" FORCE)
  add_subdirectory(external/SDL EXCLUDE_FROM_ALL)
endif()

if(HUMAN_RESOURCES_FEATURE_DETERMINISTIC_AUTHORITY)
  if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/external/flatbuffers/CMakeLists.txt")
    message(FATAL_ERROR "The deterministic-authority profile requires FlatBuffers. Run tools/project.py bootstrap")
  endif()
  set(FLATBUFFERS_BUILD_TESTS OFF CACHE BOOL "" FORCE)
  set(FLATBUFFERS_BUILD_FLATC OFF CACHE BOOL "" FORCE)
  set(FLATBUFFERS_BUILD_FLATLIB OFF CACHE BOOL "" FORCE)
  set(FLATBUFFERS_BUILD_SHAREDLIB OFF CACHE BOOL "" FORCE)
  set(FLATBUFFERS_INSTALL OFF CACHE BOOL "" FORCE)
  add_subdirectory(external/flatbuffers EXCLUDE_FROM_ALL)
endif()

if(HUMAN_RESOURCES_FEATURE_DYNAMIC_TEXT)
  if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/external/SDL_ttf/CMakeLists.txt")
    message(FATAL_ERROR "The dynamic-text profile requires SDL_ttf. Run tools/project.py bootstrap")
  endif()
  set(SDLTTF_VENDORED ON CACHE BOOL "" FORCE)
  set(SDLTTF_SAMPLES OFF CACHE BOOL "" FORCE)
  set(SDLTTF_INSTALL OFF CACHE BOOL "" FORCE)
  set(SDLTTF_HARFBUZZ ON CACHE BOOL "" FORCE)
  set(SDLTTF_PLUTOSVG OFF CACHE BOOL "" FORCE)
  # SDL_ttf selects its SDL target from BUILD_SHARED_LIBS. Keep it static so the
  # app owns one fewer runtime library and so iOS links SDL3::SDL3 correctly when
  # SDL itself is configured static-only.
  if(DEFINED BUILD_SHARED_LIBS)
    set(GAME_SAVED_BUILD_SHARED_LIBS "${BUILD_SHARED_LIBS}")
    set(GAME_HAD_BUILD_SHARED_LIBS ON)
  else()
    set(GAME_HAD_BUILD_SHARED_LIBS OFF)
  endif()
  set(BUILD_SHARED_LIBS OFF)
  add_subdirectory(external/SDL_ttf EXCLUDE_FROM_ALL)
  if(GAME_HAD_BUILD_SHARED_LIBS)
    set(BUILD_SHARED_LIBS "${GAME_SAVED_BUILD_SHARED_LIBS}")
  else()
    unset(BUILD_SHARED_LIBS)
  endif()
  unset(GAME_SAVED_BUILD_SHARED_LIBS)
  unset(GAME_HAD_BUILD_SHARED_LIBS)
endif()
